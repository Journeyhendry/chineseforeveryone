{
  "name": "chineseforeveryone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build:words": "tsx scripts/build-words.ts",
    "build:sentences": "tsx scripts/filter-sentences.ts",
    "fetch:casual-evidence": "tsx scripts/fetch-casual-evidence.ts",
    "build:casual": "tsx scripts/build-casual.ts",
    "build:word-sentences": "tsx scripts/build-word-sentences.ts",
    "check:visuals": "tsx scripts/check-visuals.ts",
    "check:data": "tsx scripts/check-data.ts",
    "build:characters": "tsx scripts/build-characters.ts",
    "build:scenes": "tsx scripts/build-scenes.ts",
    "build:lessons": "tsx scripts/build-lessons.ts",
    "build:strokes": "tsx scripts/build-strokes.ts",
    "build:font": "python3 scripts/font/build_font.py",
    "build:audio-items": "python3 scripts/tts-hsk1/hsk1_items.py"
  },
  "dependencies": {
    "hanzi-writer": "3.7.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cedict-json": "1.3.20251213",
    "hanzi-writer-data": "2.0.1",
    "opencc-js": "1.4.2",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
