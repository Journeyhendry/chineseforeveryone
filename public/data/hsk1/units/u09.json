  "dialog": {
    "id": "d-u09",
    "title": {
      "id": "Mencari toilet di mal",
      "en": "Finding the toilet in a mall"
    },
    "situation": {
      "id": "Kakek berbelanja di mal besar dan bertanya kepada penjaga toko di mana toiletnya.",
      "en": "Grandpa is shopping in a big mall and asks a shop assistant where the toilet is."
    },
    "machine": true,
    "speakers": {
      "yeye": {
        "name": {
          "id": "Kakek",
          "en": "Grandpa"
        },
        "gender": "male"
      },
      "seller": {
        "name": {
          "id": "Penjual",
          "en": "Seller"
        },
        "gender": "female"
      }
    },
    "lines": [
      {
        "speaker": "yeye",
        "gender": "male",
        "cmn": "请问，洗手间在哪儿？",
        "tokens": [
          {
            "text": "请问",
            "pinyin": "qǐngwèn"
          },
          {
            "text": "，"
          },
          {
            "text": "洗手间",
            "pinyin": "xǐshǒujiān"
          },
          {
            "text": "在",
            "pinyin": "zài"
          },
          {
            "text": "哪儿",
            "pinyin": "nǎr"
          },
          {
            "text": "？"
          }
        ],
        "en": "Excuse me, where is the toilet?",
        "id": "Permisi, toiletnya di mana?",
        "machine": true
      },
      {
        "speaker": "seller",
        "gender": "female",
        "cmn": "在前头，左边。",
        "tokens": [
          {
            "text": "在",
            "pinyin": "zài"
          },
          {
            "text": "前头",
            "pinyin": "qián tou"
          },
          {
            "text": "，"
          },
          {
            "text": "左边",
            "pinyin": "zuǒbian"
          },
          {
            "text": "。"
          }
        ],
        "en": "Up ahead, on the left.",
        "id": "Di depan, sebelah kiri.",
        "machine": true
      },
      {
        "speaker": "yeye",
        "gender": "male",
        "cmn": "前头？那边吗？",
        "tokens": [
          {
            "text": "前头",
            "pinyin": "qián tou"
          },
          {
            "text": "？"
          },
          {
            "text": "那边",
            "pinyin": "nàbiān"
          },
          {
            "text": "吗",
            "pinyin": "ma"
          },
          {
            "text": "？"
          }
        ],
        "en": "Up ahead? Over there?",
        "id": "Di depan? Sebelah sana?",
        "machine": true
      },
      {
        "speaker": "seller",
        "gender": "female",
        "cmn": "对，在那个门的旁边。",
        "tokens": [
          {
